NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel/server only. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AURA_INVITE_CODE=

# Public key is safe in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Configure these as Supabase Edge Function secrets.
# VAPID_PUBLIC_KEY should match NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
